{
  "buildCommand": "pnpm install && pnpm --filter @roomx/shared build && pnpm --filter @roomx/web build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "echo done",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api|_next|static|favicon.ico|robots.txt|manifest.json|sw.js).*)",
      "destination": "/index.html"
    }
  ]
}
