# === Backend ===
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# === WebRTC ===
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
